/* VideoBox 浅色主题
   目标不是好看，是"看起来像 2026 年的客户端而不是 1995 年的 MFC 示例"。
   只用 QSS，不做自绘 —— 两天工期内自绘控件是自杀式投资。 */

* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #1F2329;
}

QMainWindow, QWidget#Root {
    background: #F5F6F8;
}

/* ---------- 卡片 ---------- */
QFrame#Card {
    background: #FFFFFF;
    border: 1px solid #E5E6EB;
    border-radius: 10px;
}

QLabel#CardTitle {
    font-size: 14px;
    font-weight: 600;
    color: #1F2329;
    padding-bottom: 2px;
}

QLabel#Hint {
    color: #86909C;
    font-size: 12px;
}

QLabel#Value {
    color: #1F2329;
}

QLabel#Muted {
    color: #646A73;
}

/* 当前方案名：右栏的第二个视觉锚点，参数都是它的注脚 */
QLabel#PlanName {
    color: #1F2329;
    font-size: 15px;
    font-weight: 600;
}

/* 参数和目标打架时的提醒。用浅黄底而不是红色，因为多数情况不是错误 */
QLabel#Notice {
    background: #FFF7E8;
    border: 1px solid #FFE4BA;
    border-radius: 6px;
    color: #A64B00;
    padding: 7px 10px;
}

/* ---------- 空态的三步引导 ---------- */
/* 卡片是白底：右栏本身是浅灰，同色框放进去等于没画 */
QFrame#EmptyGuide {
    background: #FFFFFF;
    border: 1px solid #E5E6EB;
    border-radius: 10px;
}

QLabel#StepTitle {
    color: #1F2329;
    font-size: 16px;
    font-weight: 600;
}

QLabel#StepNo {
    background: #E1EAFB;
    border-radius: 11px;
    color: #2F6FED;
    font-size: 12px;
    font-weight: 600;
}

QLabel#Step {
    color: #1F2329;
    font-size: 14px;
    padding-top: 1px;
}

/* ---------- 缩略图占位 ---------- */
QLabel#Thumb {
    background: #F2F3F5;
    border: 1px dashed #C9CDD4;
    border-radius: 8px;
    color: #86909C;
    font-size: 13px;
}

/* ---------- 输入 ---------- */
QLineEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #FFFFFF;
    border: 1px solid #D9DCE1;
    border-radius: 6px;
    /* 显式写全四个方向：只写 padding-right 会把上下内边距一起吃掉，
       文字会被垂直裁掉半个字（720p 显示成 /20p 就是这个坑） */
    padding: 7px 10px 7px 10px;
    min-height: 20px;
    selection-background-color: #2F6FED;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QPlainTextEdit:focus, QSpinBox:focus,
QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #2F6FED;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background: #F7F8FA;
    color: #A9AEB8;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

/* 数值框的上下箭头：默认的 Windows 原生箭头又小又糊，
   换成自绘三角 + 独立按钮区，看起来才像个现代控件 */
QSpinBox, QDoubleSpinBox {
    padding: 7px 10px;
}

/* 数值框的上下按钮。
   箭头不能在这儿画——QSS 不支持用 border 拼三角形（浏览器里那套
   width:0 + 透明边框），Qt 会把剩下的边框渲染成实心方块；
   而不写规则又只剩一条没有箭头的灰条。
   所以箭头用 scripts/make_spin_arrows.py 生成的两张小图，
   __UI__ 在加载时替换成真实的样式目录。 */
QSpinBox, QDoubleSpinBox {
    padding: 7px 24px 7px 10px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #E5E6EB;
    border-top-right-radius: 5px;
    background: #F7F8FA;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border-left: 1px solid #E5E6EB;
    border-bottom-right-radius: 5px;
    background: #F7F8FA;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: #EAF1FE;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(__UI__/assets/spin_up.png);
    width: 10px;
    height: 6px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(__UI__/assets/spin_down.png);
    width: 10px;
    height: 6px;
}

/* 下拉框右侧的箭头。和数值框共用那张三角图——
   不写这条，框右边是空的，看不出能点。 */
QComboBox::down-arrow {
    image: url(__UI__/assets/chevron_down.png);
    width: 10px;
    height: 6px;
}

QComboBox QAbstractItemView {
    /* 必须用 background-color 且逐项再写一遍。
       只写 background 时，列表项仍按 palette.base() 绘制，
       某些系统主题下那是纯黑——白字变黑底黑字，整个列表等于看不见。 */
    background-color: #FFFFFF;
    color: #1F2329;
    border: 1px solid #E5E6EB;
    border-radius: 6px;
    outline: 0;
    padding: 4px 0;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 0 10px;
    background-color: #FFFFFF;
    color: #1F2329;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #EAF1FE;
    color: #2F6FED;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background: #FFFFFF;
    border: 1px solid #D9DCE1;
    border-radius: 6px;
    padding: 8px 16px;
    color: #1F2329;
}

QPushButton:hover {
    border-color: #2F6FED;
    color: #2F6FED;
}

QPushButton:pressed {
    background: #EAF1FE;
}

QPushButton:disabled {
    background: #F7F8FA;
    border-color: #E5E6EB;
    color: #C0C4CC;
}

QPushButton#Primary {
    background: #2F6FED;
    border: 1px solid #2F6FED;
    color: #FFFFFF;
    font-weight: 600;
    padding: 10px 22px;
}

QPushButton#Primary:hover {
    background: #1F5BD6;
    border-color: #1F5BD6;
    color: #FFFFFF;
}

/* 禁用态要一眼看出"现在不能点"。
   原来用浅蓝（#A9C2F5）保留品牌色，结果它看起来只是"次要按钮"，
   空态下用户会去点，点完被告知"请先打开视频"。 */
QPushButton#Primary:disabled {
    background: #F2F3F5;
    border-color: #E5E6EB;
    color: #C0C4CC;
}

QPushButton#Danger {
    background: #FFFFFF;
    border: 1px solid #F53F3F;
    color: #F53F3F;
    padding: 10px 22px;
}

QPushButton#Danger:hover {
    background: #FFECE8;
}

/* ---------- 进度 ---------- */
QProgressBar {
    background: #F2F3F5;
    border: none;
    border-radius: 5px;
    height: 10px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background: #2F6FED;
    border-radius: 5px;
}

/* ---------- 效果说明 ----------
   正文黑、风险橙。不做卡片也不做图标，因为这几行是"读一遍就懂"的信息，
   加装饰反而会把它变成需要辨认的东西 */
QLabel#EffectOk {
    color: #1F2329;
    font-size: 13px;
}

QLabel#EffectWarn {
    color: #A64B00;
    font-size: 13px;
}

/* 高级设置里的分隔线 */
QFrame#HLine {
    border: none;
    border-top: 1px solid #E5E6EB;
    max-height: 1px;
}

/* 右栏可能比窗口高（展开高级设置时），允许纵向滚动但不显示横向条 */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* 勾选框保留原生指示器：自绘的话 QSS 只能改底色，
   勾选后变成一个纯色方块，反而看不出有没有勾上 */
QCheckBox {
    color: #1F2329;
    spacing: 8px;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #C9CDD4;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #A9AEB8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ---------- 状态徽章 ---------- */
QLabel#BadgeAI {
    background: #EAF1FE;
    color: #2F6FED;
    border-radius: 4px;
    padding: 3px 9px;
    font-size: 12px;
}

QLabel#BadgeLocal {
    background: #F2F3F5;
    color: #646A73;
    border-radius: 4px;
    padding: 3px 9px;
    font-size: 12px;
}

QLabel#BadgeWarn {
    background: #FFF7E8;
    color: #D25F00;
    border-radius: 4px;
    padding: 3px 9px;
    font-size: 12px;
}

/* ---------- 结果区 ---------- */
QLabel#ResultOk {
    color: #00A55B;
    font-weight: 600;
}

QLabel#ResultFail {
    color: #F53F3F;
    font-weight: 600;
}

QLabel#CommandBox {
    background: #F7F8FA;
    border: 1px solid #E5E6EB;
    border-radius: 6px;
    padding: 8px;
    color: #4E5969;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
}

/* ---------- 技术细节折叠按钮 ----------
   长得像链接而不是按钮：它是个次要入口，不该和"开始转码"抢注意力 */
QToolButton#DetailToggle {
    background: transparent;
    border: none;
    color: #86909C;
    font-size: 12px;
    padding: 4px 0;
    text-align: left;
}

QToolButton#DetailToggle:hover {
    color: #2F6FED;
}

QMenuBar {
    background: #FFFFFF;
    border-bottom: 1px solid #E5E6EB;
}

QMenuBar::item {
    padding: 6px 12px;
    background: transparent;
}

QMenuBar::item:selected {
    background: #EAF1FE;
    border-radius: 4px;
}

QMenu {
    background: #FFFFFF;
    border: 1px solid #E5E6EB;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 7px 24px 7px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #EAF1FE;
}

QStatusBar {
    background: #FFFFFF;
    border-top: 1px solid #E5E6EB;
    color: #646A73;
}

/* 悬停提示。每个参数都有 tooltip，系统开深色主题时它会是黑底，
   而我们没写规则的话文字仍是深灰——提示框里一片看不见的字。
   应用级的浅色调色板能兜住一部分，这里再显式写死。 */
QToolTip {
    background-color: #FFFFFF;
    color: #1F2329;
    border: 1px solid #D9DCE1;
    border-radius: 4px;
    padding: 5px 8px;
}
